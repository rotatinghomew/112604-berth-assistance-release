        "until": "time",
        "draft_dm": "int",
        "beam_m": "int"
      },
      "note": "from/until 表示可进行进出动作的窗口。作业期间如果没有动作可连续系泊，左闭右开。"
    },
    "assist": {
      "key": [
        "group",
        "from"
      ],
      "fields": {
        "group": "string",
        "agency": "string",
        "kind": "string",
        "from": "time",
        "until": "time",
        "max_draft_dm": "int"
      },
      "note": "group 为对端的真实值班组标识。"
    },
    "quay_events": {
      "key": [
        "event"
      ],
      "fields": {
        "event": "string",
        "call": "string",
        "berth": "string",
